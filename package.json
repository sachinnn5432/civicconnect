{
  "name": "civicconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CivicConnect - Municipal Complaint Management System",
  "scripts": {
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm run server:install && npm run client:install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "db:seed": "npm --prefix server run db:seed",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client"
  }
}
