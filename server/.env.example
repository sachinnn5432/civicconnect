# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=civic_connect

# Authentication & Security
JWT_ACCESS_SECRET=civicconnect_jwt_access_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=civicconnect_jwt_refresh_secret_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS and Client URL
CLIENT_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
